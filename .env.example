# ─────────────────────────────────────────────────────────────────────────────
# Atelier Student — environment variables
# Copy to .env.local for development. In production every variable marked
# REQUIRED IN PRODUCTION must be set, or the server refuses to start.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the site (used in emails, Stripe redirects, sitemap). REQUIRED IN PRODUCTION
APP_URL=http://localhost:3000

# Postgres connection string. REQUIRED IN PRODUCTION.
# Leave empty locally to use the embedded Postgres (PGlite) stored in .data/pglite.
DATABASE_URL=

# Session signing secret: `openssl rand -base64 32`. REQUIRED IN PRODUCTION
BETTER_AUTH_SECRET=

# 32-byte key (base64) used to encrypt tax IDs at rest: `openssl rand -base64 32`. REQUIRED IN PRODUCTION
ENCRYPTION_KEY=

# Bearer token for /api/cron/* (auto-release, reminders, cleanup). REQUIRED IN PRODUCTION
CRON_SECRET=

# ── Payments (Stripe Connect) ── REQUIRED IN PRODUCTION
# Without a key, payments run in "simulated" mode with a fake checkout page.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Percentage kept by the platform from each completed commission.
PLATFORM_FEE_PERCENT=10
# Days after handover/shipping before payment is released automatically.
AUTO_RELEASE_DAYS=7

# ── Email (any SMTP provider: Postmark, Resend, SES, Brevo…) ── REQUIRED IN PRODUCTION
# Without SMTP_URL, emails are logged and viewable at /dev/mail.
SMTP_URL=
EMAIL_FROM="Atelier Student <hello@example.com>"
SUPPORT_EMAIL=support@example.com

# ── Photo storage (any S3-compatible service: S3, Cloudflare R2, Scaleway…) ──
# Without S3_BUCKET, photos are stored on local disk in UPLOAD_DIR.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
UPLOAD_DIR=.data/uploads

# ── Trust & safety ──
# School email domains that instantly verify a student (comma-separated).
SCHOOL_EMAIL_DOMAINS=hva.nl,artez.nl,wdka.nl,kabk.nl,hku.nl,avans.nl,saxion.nl,amfi.nl
# These email addresses get the admin role once their email is verified.
ADMIN_EMAILS=

# ── Company details (shown in the footer, legal pages and emails) ──
COMPANY_NAME="Atelier Student B.V."
COMPANY_KVK=
COMPANY_ADDRESS=
